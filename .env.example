# TS-GNN Environment Variables
# Copy this file to .env and fill in the values.

# ── Weights & Biases (experiment tracking) ──
# Set to your W&B API key to enable logging. Leave empty to disable.
WANDB_API_KEY=
WANDB_PROJECT=tsgnn

# ── Compute ──
# Force a specific CUDA device (e.g. "cuda:0", "cuda:1", or "cpu")
TSGNN_DEVICE=

# ── Data Directories ──
# Override default data directory (default: ts-gnn/data/)
TSGNN_DATA_DIR=

# ── ESM-2 ──
# Path to pre-downloaded ESM-2 model weights (optional, auto-downloads if empty)
ESM_MODEL_DIR=
